# ============================================================
# 对话引擎配置（推荐，独立部署必填）
# ============================================================
# 任选一个 OpenAI 兼容服务商填写即可，Agent 立即具备对话能力。
# 也可以启动后在页面「设置 → 对话引擎」中填写，效果相同。
# 注意：模型下拉列表会实时调用该服务商的 /models 接口拉取真实模型，
# 接入什么 API 就显示什么模型，不会显示未配置的模型。

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# 常用服务商参考（填写自己的 API Key 后，页面会自动拉取该平台真实模型）：
#   DeepSeek       https://api.deepseek.com/v1                          deepseek-v4-flash
#   通义千问        https://dashscope.aliyuncs.com/compatible-mode/v1    qwen-plus
#   Kimi           https://api.moonshot.cn/v1                           moonshot-v1-8k
#   智谱 GLM        https://open.bigmodel.cn/api/paas/v4                 glm-4-plus
#   OpenAI         https://api.openai.com/v1                            gpt-4o-mini

# ============================================================
# CodeBuddy Agent SDK（可选）
# ============================================================
# 注意：SDK 通过 spawn headless CLI 子进程工作，该 CLI 依赖宿主运行时
# （WorkBuddy Desktop）在进程内提供网关鉴权。在独立部署环境中，
# initialize 握手无法完成（表现为请求静默超时）。
# 若你的环境具备有效的公网 CodeBuddy 凭据，可填写下方变量启用该链路。

# CODEBUDDY_API_KEY=
# CODEBUDDY_AUTH_TOKEN=
# CODEBUDDY_INTERNET_ENVIRONMENT=
# CODEBUDDY_BASE_URL=

# ============================================================
# 服务
# ============================================================
PORT=3000

# ============================================================
# 软件授权（License）
# ============================================================
# 离线 HMAC-SHA256 签发授权码所用的密钥（≥ 16 字符，建议 64 字符随机）。
# 管理员在本机生成一次后写到 .env，再用 scripts/generate-license.ts 签发授权码给用户。
# 未配置时所有受保护功能会被锁定。

# 生成方法（任选其一）：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   openssl rand -hex 32

LICENSE_SECRET=

# ============================================================
# 视频蒸馏 · 语音识别（ASR）
# ============================================================
# 视频蒸馏在无字幕时会用本地 faster-whisper 把音频转成文字（语音识别）。
# 下面是可选调优项，不填即用合理默认值。

# ASR 模型大小（默认 small，中文识别更准）：
#   tiny < base < small < medium < large-v3
#   越大越准但越慢、占磁盘越多。CPU 上 small 是准确率/速度的平衡点。
# DISTILL_ASR_MODEL=small

# 完全禁用 ASR（仅返回字幕/元数据，不识别音频）：
# DISTILL_SKIP_ASR=1

# 模型下载镜像（国内环境已默认 hf-mirror.com，一般无需修改）：
# HF_ENDPOINT=https://hf-mirror.com

# ============================================================
# AI 生图（支持多服务商）
# ============================================================
# 服务商 1：通义万相（阿里云 DashScope）
DASHSCOPE_API_KEY=

# 服务商 2：OpenAI 兼容生图服务（硅基流动 / 智谱 CogView / MiniMax / StepFun 等）
#   API Key 必填；BaseURL 与模型名不填则用默认值。
# IMAGE_GEN_OPENAI_API_KEY=
# IMAGE_GEN_OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# IMAGE_GEN_OPENAI_MODEL=black-forest-labs/FLUX.1-schnell
